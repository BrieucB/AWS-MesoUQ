{
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "connector_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Connector Id",
      "type": "string"
    },
    "site": {
      "const": "karolina",
      "title": "Site",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Request Id",
      "type": "string"
    },
    "signature": {
      "maxLength": 128,
      "title": "Signature",
      "type": "string"
    },
    "campaign_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Campaign Id"
    },
    "exclude_stage_ids": {
      "anyOf": [
        {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exclude Stage Ids"
    }
  },
  "required": [
    "project_id",
    "connector_id",
    "site",
    "request_id",
    "signature"
  ],
  "title": "Claim",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mesouq.invalid/schemas/benchmark-claim.schema.json"
}
