      "title": "Project Id",
      "type": "string"
    },
    "campaign_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Campaign Id",
      "type": "string"
    },
    "connector_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Connector Id",
      "type": "string"
    },
    "event_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Event Id",
      "type": "string"
    },
    "type": {
      "const": "archive_verified",
      "title": "Type",
      "type": "string"
    },
    "receipt": {
      "additionalProperties": true,
      "title": "Receipt",
