    },
    "signature": {
      "maxLength": 128,
      "title": "Signature",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "campaign_id",
    "connector_id",
    "event_id",
    "type",
    "receipt",
    "signature"
