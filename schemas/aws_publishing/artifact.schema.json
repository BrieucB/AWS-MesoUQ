{
  "$id": "urn:mesouq:aws-publishing:v1:artifact",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "kind": {
      "enum": [
        "curve",
        "training_table",
        "result",
        "posterior",
        "model",
        "validation",
        "log",
        "manifest"
      ]
    },
    "media_type": {
      "minLength": 1,
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "id",
    "name",
    "kind",
    "sha256",
    "size_bytes",
    "media_type"
  ],
  "type": "object"
}
